{
  "name": "skinshift",
  "version": "0.1.0",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test:unit": "node --test test/contrast.test.js",
    "test:e2e": "node test/e2e/smoke.mjs && node test/e2e/multisite.mjs && node test/e2e/popup-ui.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:selectors": "playwright test",
    "screenshots": "node tools/screenshots.mjs",
    "icons": "node tools/run-icons.mjs",
    "package": "node tools/package.mjs"
  },
  "keywords": ["chrome-extension", "privacy", "personalization", "chatgpt", "claude", "gemini", "wallpaper"],
  "author": "Mounesh Kodangal",
  "homepage": "https://github.com/Mounesh-13/skinshift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mounesh-13/skinshift.git"
  },
  "bugs": {
    "url": "https://github.com/Mounesh-13/skinshift/issues"
  },
  "license": "MIT",
  "description": "SkinShift for AI Chats: a 100% local Chrome extension that adds a wallpaper and frosted-glass layer to ChatGPT, Claude and Gemini.",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "playwright": "^1.64.0"
  },
  "private": true
}